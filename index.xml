---
layout: null
permalink: /index.xml
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>{{ site.title | xml_escape }}</title>
<link>{{ '/' | absolute_url }}</link>
<atom:link href="{{ '/index.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
<description>{{ site.tagline | xml_escape }}</description>
<language>en</language>
<lastBuildDate>{{ site.posts.first.date | date_to_rfc822 }}</lastBuildDate>
{% for post in site.posts limit:15 %}
<item>
<title>{{ post.title | xml_escape }}</title>
<link>{{ post.url | absolute_url }}</link>
<guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
<description>{{ post.content | xml_escape }}</description>
{% for c in post.categories %}<category>{{ c | xml_escape }}</category>
{% endfor %}<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
</item>
{% endfor %}
</channel>
</rss>
